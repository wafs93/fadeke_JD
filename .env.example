# Copy to .env.local (gitignored) and fill in. Never commit real values.

# Supabase (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by cron routes and the seed script. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
# Optional model overrides
OPENAI_MODEL=gpt-4o

# Vercel Cron shared secret. Vercel sends it as "Authorization: Bearer <value>".
# Send the same header when calling /api/cron/* by hand.
CRON_SECRET=

# Comma-separated list of job sources to use. Leave blank for all of them.
# Options: remotive,remoteok,weworkremotely,jobicy,himalayas
JOB_SOURCES=

# How many new jobs GPT-4o scores per run (keeps cost predictable)
MATCH_BATCH_SIZE=15

# Telegram daily digest (optional; off unless TELEGRAM_ENABLED=true)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public URL of the deployed app, used for links in the digest
APP_URL=
